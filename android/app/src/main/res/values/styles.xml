<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown while Flutter initializes; a plain brand-colored background
         avoids any visible white/black flash. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- Theme applied once the first Flutter frame is drawn. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/normal_background</item>
    </style>
</resources>
